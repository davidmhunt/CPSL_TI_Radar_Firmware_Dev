#!/bin/bash
# fw: build, test, flash, verify and publish the firmware projects in projects/.
# All logic lives in tools/fwcli/ (stdlib Python >= 3.11). Guide: projects/README.md; `./fw help`.
set -euo pipefail
FW_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export FW_ROOT
PY="${FW_PYTHON:-python3}"
"$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null \
    || { echo "fw: error: python3 >= 3.11 is required (found: $("$PY" -V 2>&1))" >&2; exit 2; }
PYTHONPATH="${FW_ROOT}/tools${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -B -m fwcli "$@"
