# project.env: facts about this project, read by `./fw list` and sourced by build.sh / flash.sh.
# Stock (unmodified) TI mmWave SDK 3.6 mmw demos; no TI source is tracked here.
BOARD="IWR1843BOOST+IWR6843ISK"
SDK="mmwave_sdk"
SDK_VERSION="03.06.02.00-LTS"
# Compilers come from the SDK's setenv.sh (not the image's 20.2.7.LTS).
TOOLCHAIN="ti-cgt-arm 16.9.6.LTS + ti-cgt-c6000 8.3.3 (SDK make, XDC 3.50.08.24, BIOS 6.73.01.01)"
# TI source built: path only, nothing is copied into src/ (stock project).
BASELINE="mmwave_sdk_03_06_02_00-LTS/packages/ti/demo/xwr{18,68}xx/mmw"
BASELINE_COMMIT="n/a (stock, untracked)"
# First entry is what flash.sh offers by default.
ARTIFACTS="iwr1843_demo.bin iwr1843_demo.elf iwr6843_demo.bin iwr6843_demo.elf"
