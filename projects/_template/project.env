# project.env: facts about this project, read by `./fw list` and sourced by build.sh / flash.sh.
# Plain KEY="value" lines only (no commands): `./fw list` sources this file on the host.
# Replace every TODO. Keys are explained in projects/README.md, section 3.

# Board the image runs on.                          e.g. IWR1843BOOST
BOARD="TODO"

# TI SDK it builds against, and its exact version.  e.g. mmwave_sdk / 03.06.02.00-LTS
SDK="TODO"
SDK_VERSION="TODO"

# Compilers / build tool and versions.              e.g. ti-cgt-arm 16.9.6.LTS (SDK make)
TOOLCHAIN="TODO"

# TI source the project started from: path + version.
#                                   e.g. mmwave_sdk_03_06_02_00-LTS/packages/ti/demo/xwr18xx/mmw
BASELINE="TODO"

# firmware_dev commit that added that source unmodified.   e.g. 1a2b3c4
BASELINE_COMMIT="TODO"

# Files build.sh leaves in build/, space-separated; flash.sh flashes the first by default.
#                                                   e.g. xwr18xx_mmw_demo.bin
ARTIFACTS="TODO"
