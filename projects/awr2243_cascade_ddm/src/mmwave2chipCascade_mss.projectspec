<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="Cortex R.AM273x"
            />
        </when>
    </applicability>

    <!-- Project Settings -->
    <project
        title="am273x_mmw_cascade_demo_mss"
        name = "am273x_mmw_cascade_demo_mss"
        products="sysconfig:1.22.0;com.ti.MCU_PLUS_SDK_AM273X:8.5.0.24;com.ti.MMWAVE_MCUPLUS_SDK:4.4.0.01"
        configurations="
            Debug,
            Release,
        "
        connection="TIXDS110_Connection.xml"
        toolChain="TICLANG"
        cgtVersion="2.1.1.LTS"
        device="Cortex R.AM273x"
        deviceCore="Cortex_R5_0"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        endianness="little"
        outputFormat="ELF"
        outputType="executable"

        compilerBuildOptions="
            -I${CG_TOOL_ROOT}/include/c
            -I${MCU_PLUS_SDK_PATH}/source
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/FreeRTOS-Kernel/include
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/portable/TI_ARM_CLANG/ARM_CR5F
            -I${MCU_PLUS_SDK_PATH}/source/kernel/freertos/config/am273x/r5f
            -I${MMWAVE_SDK_INSTALL_PATH}/ti/demo/utils
            -I${MMWAVE_SDK_INSTALL_PATH}/ti/alg/gtrack
            -I${PROJECT_LOC}
            -I${PROJECT_LOC}/ti/demo/am273x/mmw/mss/mssgenerated
            -mcpu=cortex-r5
            -mfloat-abi=hard
            -mfpu=vfpv3-d16
            -mlittle-endian
            -Wall
            -Werror
            -g
            -Wno-gnu-variable-sized-type-not-at-end
            -Wno-unused-function
            -DDOWNLOAD_FROM_CCS
            -DDRIVERS_RADAR_HWA_V2
            -DDebugP_LOG_ENABLED
            -DMMWDEMO_DDM
            -DCASCADE_EVM
            -DSOC_AM273X
            -DAPP_RESOURCE_FILE=&apos;&lt;&apos;ti/demo/am273x/mmw/mmw_resDDM.h&apos;&gt;&apos;
            -D_LITTLE_ENDIAN
            -MMD
            -D=SUBSYS_MSS
            -mthumb 
            -O3
        "
        linkerBuildOptions="
            -i${CG_TOOL_ROOT}/lib
            -i${PROJECT_LOC}
            -i${MCU_PLUS_SDK_PATH}/source/kernel/freertos/lib
            -i${MCU_PLUS_SDK_PATH}/source/drivers/lib
            -i${MCU_PLUS_SDK_PATH}/source/board/lib
            -i${PROJECT_LOC}/ti/control/mmwavelink/lib
            -i${PROJECT_LOC}/ti/control/mmwave/lib
            -i${PROJECT_LOC}/ti/utils/cli/lib
            -i${PROJECT_LOC}/ti/control/dpm/lib 
            -i${MMWAVE_SDK_INSTALL_PATH}/ti/utils/mathutils/lib
            -i${MMWAVE_SDK_INSTALL_PATH}/ti/alg/gtrack/lib   
            -i${MMWAVE_SDK_INSTALL_PATH}/ti/utils/testlogger/lib      
            -m=${ProjName}.${ConfigName}.map
            --diag_suppress=10063
            --ram_model
            --reread_libs
            -o ${ProjName}.xer5f
            -llibmmwavelink_cascade_am273x.aer5f -llibmmwave_cascade_am273x.aer5f -llibcli_cascade_am273x.aer5f -llibdpm_am273x.aer5f -llibmathutils.aer5f -llibgtrack3D_am273x.aer5f -llibtestlogger_am273x.aer5f
        "
        preannouncebuildStep="Deleting old out files"
        preBuildStep = "${CCE_INSTALL_ROOT}/utils/cygwin/rm -f ${CCS_PROJECT_DIR}/${ConfigName}/${ProjName}_strip.rprc;
                        ${CCE_INSTALL_ROOT}/utils/cygwin/rm -f ${CCS_PROJECT_DIR}/${ConfigName}/${ProjName}_strip.xer5f;"
        postannouncebuildStep="Preparing RPRC format image"
        postBuildStep="${CG_TOOL_ROOT}/bin/tiarmstrip -p ${CCS_PROJECT_DIR}/${ConfigName}/${ProjName}.xer5f -o=${CCS_PROJECT_DIR}/${ConfigName}/${ProjName}_strip.xer5f;
                        ${SYSCONFIG_TOOL_ROOT}/nodejs/node.exe ${COM_TI_MCU_PLUS_SDK_AM273X_INSTALL_DIR}/tools/boot/out2rprc/elf2rprc.js ${CCS_PROJECT_DIR}/${ConfigName}/${ProjName}_strip.xer5f;
                        ${SYSCONFIG_TOOL_ROOT}/nodejs/node.exe ${COM_TI_MCU_PLUS_SDK_AM273X_INSTALL_DIR}/tools/boot/multicoreImageGen/multicoreImageGen.js --devID 55 --out ${CCS_PROJECT_DIR}/am273x_mmw_cascade_demo_DDM.appimage ${CCS_PROJECT_DIR}/${ConfigName}/${ProjName}_strip.rprc@0 ${CCS_PROJECT_DIR}/../am273x_mmw_cascade_demo_dss/${ConfigName}/am273x_mmw_cascade_demo_dss_strip.rprc@2;
                        "

        enableSysConfigTool="true"
        sysConfigBuildOptions="
            -o ${PROJECT_ROOT}/ti/demo/am273x/mmw/mss/mssgenerated --context r5fss0-0 --part Default --package ZCE 
        "

        description="mmave 2 chip cascade">
        
        <configuration name="Debug"
            compilerBuildOptions="
                -D_DEBUG_=1
            "
            linkerBuildOptions="
                -lboard.am273x.r5f.ti-arm-clang.debug.lib
                -lfreertos.am273x.r5f.ti-arm-clang.debug.lib
                -ldrivers.am273x.r5f.ti-arm-clang.debug.lib
                -llibc.a
            "
        ></configuration>
        <configuration name="Release"
            compilerBuildOptions="
                -Os
            "
            linkerBuildOptions="
                -lboard.am273x.r5f.ti-arm-clang.release.lib
                -lfreertos.am273x.r5f.ti-arm-clang.release.lib
                -ldrivers.am273x.r5f.ti-arm-clang.release.lib
                -llibc.a
            "
        ></configuration>

        <!-- Project path variables -->
        <pathVariable name="MCU_PLUS_SDK_PATH" path="${COM_TI_MCU_PLUS_SDK_AM273X_INSTALL_DIR}" scope="project" />
        <pathVariable name="MMWAVE_SDK_INSTALL_PATH" path= "${COM_TI_MMWAVE_MCUPLUS_SDK_INSTALL_DIR}" scope="project" />
        <pathVariable name="MMWAVE_AWR294X_DFP_INSTALL_PATH" path="${COM_TI_MMWAVE_MCUPLUS_SDK_INSTALL_DIR}/../mmwave_dfp_02_04_08_01" scope="project" />

        <!-- Project files -->
        <file path="ti/demo/utils/mmwdemo_adcconfig.c" targetDirectory="ti/demo/utils" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/demo/utils/mmwdemo_adcconfig.h" targetDirectory="ti/demo/utils" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/demo/utils/mmwdemo_monitor.c" targetDirectory="ti/demo/utils" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/demo/utils/mmwdemo_monitor.h" targetDirectory="ti/demo/utils" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/demo/utils/mmwdemo_flash.c" targetDirectory="ti/demo/utils" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/demo/utils/mmwdemo_flash.h" targetDirectory="ti/demo/utils" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/demo/utils/mmwdemo_rfparserDDMA.c" targetDirectory="ti/demo/utils" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/demo/utils/mmwdemo_rfparser.h" targetDirectory="ti/demo/utils" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/demo/utils/mmwdemo_error.h" targetDirectory="ti/demo/utils" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/demo/utils/enet_stream.h" targetDirectory="ti/demo/utils" openOnCreation="false" excludeFromBuild="false" action="copy"></file>

        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/utils/cli/cli.h" targetDirectory="ti/utils/cli" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/utils/testlogger/logger.h" targetDirectory="ti/utils/testlogger" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/utils/mathutils/mathutils.h" targetDirectory="ti/utils/mathutils" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/utils/cli/lib/libcli_cascade_am273x.aer5f" targetDirectory="ti/utils/cli/lib" openOnCreation="false" excludeFromBuild="false" action="copy"></file>

        <file path="ti/common/syscommon.h" targetDirectory="ti/common" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/common/sys_types.h" targetDirectory="ti/common" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/common/sys_defs.h" targetDirectory="ti/common" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/common/mmwave_error.h" targetDirectory="ti/common" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/common/mmwavesdk_version.h" targetDirectory="ti/common" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/common/sys_common_am273x.h" targetDirectory="ti/common" openOnCreation="false" excludeFromBuild="false" action="copy"></file>

        <file path="ti/board/antenna_geometry.h" targetDirectory="ti/board" openOnCreation="false" excludeFromBuild="false" action="copy"></file>

        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/control/dpm/dpm.h" targetDirectory="ti/control/dpm/" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/control/mmwave/mmwave.h" targetDirectory="ti/control/mmwave" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/control/mmwavelink/mmwavelink.h" targetDirectory="ti/control/mmwavelink" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/control/mmwavelink/include/rl_datatypes.h" targetDirectory="ti/control/mmwavelink/include" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/control/mmwavelink/include/rl_device.h" targetDirectory="ti/control/mmwavelink/include" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/control/mmwavelink/include/rl_sensor.h" targetDirectory="ti/control/mmwavelink/include" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/control/mmwavelink/include/rl_monitoring.h" targetDirectory="ti/control/mmwavelink/include" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/control/mmwavelink/include/rl_protocol.h" targetDirectory="ti/control/mmwavelink/include" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/control/mmwavelink/include/rl_messages.h" targetDirectory="ti/control/mmwavelink/include" openOnCreation="false" excludeFromBuild="false" action="copy"></file>

        <file path="ti/control/mmwavelink/lib/libmmwavelink_cascade_am273x.aer5f" targetDirectory="ti/control/mmwavelink/lib" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/control/mmwave/lib/libmmwave_cascade_am273x.aer5f" targetDirectory="ti/control/mmwave/lib" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/control/dpm/lib/libdpm_am273x.aer5f" targetDirectory="ti/control/dpm/lib" openOnCreation="false" excludeFromBuild="false" action="copy"></file>

        <file path="ti/alg/gtrack/gtrack.h" targetDirectory="ti/alg/gtrack"  openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/demo/am273x/mmw/mmw_resDDM.h" targetDirectory="ti/demo/am273x/mmw"  openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/demo/am273x/mmw/include/mmw_config.h" targetDirectory="ti/demo/am273x/mmw/include"  openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/demo/am273x/mmw/include/mmw_output.h" targetDirectory="ti/demo/am273x/mmw/include"  openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        
        <file path="ti/datapath/dpc/objectdetection/objdethwaDDMA/objectdetection.h" targetDirectory="ti/datapath/dpc/objectdetection/objdethwaDDMA" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/datapath/dpif/dpif_pointcloud.h" targetDirectory="ti/datapath/dpif" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/datapath/dpif/dpif_types.h" targetDirectory="ti/datapath/dpif" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/datapath/dpif/dpif_adcdata.h" targetDirectory="ti/datapath/dpif" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/datapath/dpif/dpif_radarcube.h" targetDirectory="ti/datapath/dpif" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/datapath/dpif/dp_error.h" targetDirectory="ti/datapath/dpif" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/datapath/dpif/dpif_detmatrix.h" targetDirectory="ti/datapath/dpif" openOnCreation="false" excludeFromBuild="false" action="copy"></file>

        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/datapath/dpedma/dpedmahwa.h" targetDirectory="ti/datapath/dpedma" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/datapath/dpedma/dpedma.h" targetDirectory="ti/datapath/dpedma" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/datapath/dpu/rangeproc/rangeproc_common.h" targetDirectory="ti/datapath/dpu/rangeproc" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/datapath/dpu/dopplerprocDDMA/dopplerprocDDMAcommon.h" targetDirectory="ti/datapath/dpu/dopplerprocDDMA" openOnCreation="false" excludeFromBuild="false" action="copy"></file>

