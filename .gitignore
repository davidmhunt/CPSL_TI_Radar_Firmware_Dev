# Build directories and artifacts (anchored to repo root so same-named
# folders inside the firmware source tree are not silently ignored)
/build/
/bin/
*.o
*.d
*.elf
*.bin
*.appimage
*.out
*.map
*.release
*.debug
*.aer5f
*.ae66

# Exceptions: prebuilt cascade libraries the demo links against (sourced from
# Radar Toolbox 4.00.00.05; libcli has no source in this repo, so it must be tracked)
!firmware/cascade/src/demo/src/awr2243/ti/**/lib/*_cascade_am273x.aer5f
!firmware/cascade/src/demo/src/awr2243/ti/**/lib/*_cascade_am273x.ae66
# Exception: TI prebuilt cascade demo image referenced by prebuilt_binaries/demo.cfg
!firmware/cascade/src/demo/prebuilt_binaries/*.appimage

# Local SDK downloads and installations (to keep the repo clean)
/sdks/
/ti/
/downloads/*
!/downloads/download.sh
/ti-cgt-*/
/sysconfig*/

# IDE settings
.vscode/
.idea/
*.suo
*.user

# Python virtual environment and caches
__pycache__/
*.pyc
.venv/
.pytest_cache/
