# project.env: facts about this project, read by `./fw list` and sourced by build.sh / flash.sh.
# Plain KEY="value" lines only (no commands): `./fw list` sources this file on the host.
BOARD="IWR1843BOOST"
SDK="mmwave_sdk"
SDK_VERSION="03.06.02.00-LTS"
# Compilers come from the SDK's setenv.sh (not the image's 20.2.7.LTS). MSS-only image since
# firmware-07: no DSP code is built, so the SDK's C6000 compiler is not used.
TOOLCHAIN="ti-cgt-arm 16.9.6.LTS (SDK make, XDC 3.50.08.24, BIOS 6.73.01.01)"
# TI source copied unmodified into src/ (configs/ and tools/ hold the demo's profiles/).
BASELINE="mmwave_sdk_03_06_02_00-LTS/packages/ti/demo/xwr18xx/mmw"
# firmware_dev commit that added that source unmodified.
BASELINE_COMMIT="bb3a348"
# First entry is what flash.sh flashes by default.
ARTIFACTS="iwr1843_sar_lvds.bin iwr1843_sar_lvds.elf"
