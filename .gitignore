# Build directories and artifacts (anchored to the project folders so same-named
# folders inside the firmware source tree are not silently ignored)
/projects/*/build/
/bin/
*.o
*.d
*.elf
*.bin
*.appimage
*.out
*.map
*.release
*.debug
*.aer5f
*.ae66

# Exceptions: prebuilt libraries the cascade projectspecs link against (from Radar Toolbox
# 4.00.00.05; the build falls back to the toolbox copy, but committed copies take precedence)
!projects/awr2243_cascade_ddm/src/ti/**/lib/*.aer5f
!projects/awr2243_cascade_ddm/src/ti/**/lib/*.ae66
# Exception: TI prebuilt cascade demo image referenced by prebuilt_binaries/demo.cfg
!projects/awr2243_cascade_ddm/prebuilt_binaries/*.appimage

# Local SDK downloads and installations (to keep the repo clean)
/sdks/
/ti/
/downloads/*
!/downloads/download.sh
/ti-cgt-*/
/sysconfig*/

# IDE settings
.vscode/
.idea/
*.suo
*.user

# Python virtual environment and caches
__pycache__/
*.pyc
.venv/
.pytest_cache/
