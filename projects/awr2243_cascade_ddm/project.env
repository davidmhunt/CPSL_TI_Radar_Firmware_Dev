# project.env: facts about this project, read by `./fw list` and sourced by build.sh / flash.sh.
# Plain KEY="value" lines only (no commands). Keys are explained in projects/README.md, section 3.

BOARD="AWR2243-2X-CAS-EVM"
SDK="mmwave_mcuplus_sdk"
SDK_VERSION="04.04.00.01"
TOOLCHAIN="CCS 12.8.1 headless; ti-cgt-armllvm 2.1.1.LTS (R5F), ti-cgt-c6000 8.3.12 (C66x); SysConfig 1.22.0"

# Radar Toolbox lab source this started from (changes vs TI: see README.md).
BASELINE="radar_toolbox_4_00_00_05/source/ti/examples/Automotive_ADAS_and_Parking/mmwave_2_chip_cascade/src/awr2243"
# 704930d is the first commit tracking the source, and it already contains our edits:
# there is no unmodified-baseline commit for this project.
BASELINE_COMMIT="704930d"

# First file is what flash.sh flashes by default.
ARTIFACTS="am273x_cascade.appimage am273x_cascade.elf am273x_cascade_dss.xe66"
