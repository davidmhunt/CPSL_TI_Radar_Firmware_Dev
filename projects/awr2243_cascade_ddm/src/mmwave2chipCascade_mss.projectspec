        <file path="${MMWAVE_SDK_INSTALL_PATH}/ti/datapath/dpu/rangecfarprocDDMA/rangecfarproccommon.h" targetDirectory="ti/datapath/dpu/rangecfarprocDDMA" openOnCreation="false" excludeFromBuild="false" action="copy"></file>
