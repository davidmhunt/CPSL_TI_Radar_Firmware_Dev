        <file path="ti/demo/am273x/mmw/mss/mmw_cli.c" targetDirectory="ti/demo/am273x/mmw/mss"  openOnCreation="false" excludeFromBuild="false" action="copy"></file>
        <file path="ti/demo/am273x/mmw/mss/gtrackAlloc.c" targetDirectory="ti/demo/am273x/mmw/mss"  openOnCreation="false" excludeFromBuild="false" action="copy"></file>
